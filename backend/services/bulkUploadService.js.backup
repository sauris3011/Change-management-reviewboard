/**
 * Bulk Upload Service
 * Handles CSV/Excel file parsing, validation, and batch processing
 */

const xlsx = require('xlsx');
const csv = require('csv-parser');
const fs = require('fs');
const { v4: uuidv4 } = require('uuid');
const entityExtractor = require('./entityExtractor');
const featureEngine = require('./featureEngine');
const riskScorer = require('./riskScorer');
const llmService = require('./llmService');
const Database = require('../database/db');

// Valid enum values
const VALID_CHANGE_TYPES = ['standard', 'normal', 'emergency'];
const VALID_CHANGE_CATEGORIES = ['deployment', 'database', 'infrastructure', 'configuration'];
const VALID_COMPLEXITY = ['low', 'medium', 'high'];
const VALID_PRIORITY = ['low', 'medium', 'high', 'critical'];

// Required columns
const REQUIRED_COLUMNS = [
  'short_description',
  'long_description',
  'change_type',
  'change_category',
  'implementation_steps',
  'validation_steps',
  'rollback_plan',
  'planned_window',
  'impacted_services'
];

/**
 * Parse Excel file to JSON
 */
function parseExcelFile(filePath) {
  try {
    const workbook = xlsx.readFile(filePath);
    const sheetName = workbook.SheetNames[0];
    const worksheet = workbook.Sheets[sheetName];
    const data = xlsx.utils.sheet_to_json(worksheet, { defval: '' });
    return { success: true, data };
  } catch (error) {
    return { success: false, error: error.message };
  }
}

/**
 * Parse CSV file to JSON
 */
function parseCSVFile(filePath) {
  return new Promise((resolve) => {
    const results = [];
    fs.createReadStream(filePath)
      .pipe(csv())
      .on('data', (data) => results.push(data))
      .on('end', () => {
        resolve({ success: true, data: results });
      })
      .on('error', (error) => {
        resolve({ success: false, error: error.message });
      });
  });
}

/**
 * Validate a single change row
 */
function validateChangeRow(row, rowNumber) {
  const errors = [];

  // Check required fields
  for (const field of REQUIRED_COLUMNS) {
    if (!row[field] || row[field].toString().trim() === '') {
      errors.push(`Missing required field: ${field}`);
    }
  }

  // Validate enums
  if (row.change_type && !VALID_CHANGE_TYPES.includes(row.change_type.toLowerCase())) {
    errors.push(`Invalid change_type: ${row.change_type}. Must be one of: ${VALID_CHANGE_TYPES.join(', ')}`);
  }

  if (row.change_category && !VALID_CHANGE_CATEGORIES.includes(row.change_category.toLowerCase())) {
    errors.push(`Invalid change_category: ${row.change_category}. Must be one of: ${VALID_CHANGE_CATEGORIES.join(', ')}`);
  }

  if (row.complexity && !VALID_COMPLEXITY.includes(row.complexity.toLowerCase())) {
    errors.push(`Invalid complexity: ${row.complexity}. Must be one of: ${VALID_COMPLEXITY.join(', ')}`);
  }

  // Validate date format
  if (row.planned_window) {
    const date = new Date(row.planned_window);
    if (isNaN(date.getTime())) {
      errors.push(`Invalid planned_window format: ${row.planned_window}. Use ISO 8601 format (e.g., 2024-03-20T14:00:00Z)`);
    }
  }

  // Validate length limits
  if (row.short_description && row.short_description.length > 200) {
    errors.push('short_description exceeds 200 characters');
  }

  if (row.long_description && row.long_description.length > 5000) {
    errors.push('long_description exceeds 5000 characters');
  }

  if (errors.length > 0) {
    return {
      valid: false,
      errors,
      error: errors.join('; ')
    };
  }

  return { valid: true };
}

/**
 * Transform row data to change object
 */
function transformRowToChange(row) {
  // Parse implementation steps (support pipe-separated or newline-separated)
  let implementationSteps = [];
  if (row.implementation_steps) {
    if (row.implementation_steps.includes('|')) {
      implementationSteps = row.implementation_steps.split('|').map(s => s.trim());
    } else if (row.implementation_steps.includes('\n')) {
      implementationSteps = row.implementation_steps.split('\n').map(s => s.trim()).filter(s => s);
    } else {
      implementationSteps = [row.implementation_steps];
    }
  }

  // Parse validation steps
  let validationSteps = [];
  if (row.validation_steps) {
    if (row.validation_steps.includes('|')) {
      validationSteps = row.validation_steps.split('|').map(s => s.trim());
    } else if (row.validation_steps.includes('\n')) {
      validationSteps = row.validation_steps.split('\n').map(s => s.trim()).filter(s => s);
    } else {
      validationSteps = [row.validation_steps];
    }
  }

  // Parse impacted services (comma-separated)
  let impactedServices = [];
  if (row.impacted_services) {
    impactedServices = row.impacted_services.split(',').map(s => s.trim()).filter(s => s);
  }

  return {
    short_description: row.short_description.trim(),
    long_description: row.long_description.trim(),
    change_type: row.change_type.toLowerCase(),
    change_category: row.change_category.toLowerCase(),
    complexity: row.complexity ? row.complexity.toLowerCase() : 'medium',
    implementation_steps: implementationSteps,
    validation_steps: validationSteps,
    rollback_plan: row.rollback_plan.trim(),
    planned_window: row.planned_window,
    impacted_services: impactedServices,
    change_id: row.change_id || `CHG${Math.floor(100000 + Math.random() * 900000)}`,
    assignee: row.assignee || 'Unassigned',
    priority: row.priority ? row.priority.toLowerCase() : 'medium'
  };
}

/**
 * Process a single change through the risk assessment pipeline
 */
async function processChange(changeData, historicalChanges = [], db) {
  try {
    // Ensure historicalChanges is an array
    if (!Array.isArray(historicalChanges)) {
      historicalChanges = [];
    }
    // Step 1: Entity extraction
    const entities = entityExtractor.extractEntities(changeData);

    // Step 2: Feature engineering
    const features = {
      rollback_quality_score: featureEngine.calculateRollbackQuality(changeData.rollback_plan),
      evidence_score: featureEngine.calculateEvidenceScore(changeData.validation_steps),
      complexity_score: featureEngine.calculateComplexityScore(changeData),
      is_peak_hours: featureEngine.isDuringPeakHours(changeData.planned_window),
      historical_failure_rate: featureEngine.calculateHistoricalFailureRate(changeData, historicalChanges)
    };

    // Step 3: Risk scoring
    const blastRadiusScore = entities.blast_radius_score || 0.5;
    const probabilities = riskScorer.calculateProbabilities(features, blastRadiusScore);
    const riskScore = riskScorer.calculateRiskScore(probabilities, features, blastRadiusScore) || 50;
    const riskBand = riskScorer.getRiskBand(riskScore);
    const similarChanges = riskScorer.findSimilarChanges(changeData, historicalChanges) || [];

    // Step 4: LLM explanation (using mock for bulk to save API costs)
    const llmAssessment = llmService.generateMockAssessment(
      changeData,
      features,
      probabilities,
      similarChanges
    );

    // Step 5: Store in database
    const predictionId = `pred_${uuidv4()}`;
    const result = {
      prediction_id: predictionId,
      change_id: changeData.change_id,
      short_description: changeData.short_description,
      risk_score: Math.round(riskScore * 100) / 100,
      risk_band: riskBand,
      probabilities,
      drivers: llmAssessment.drivers,
      positive_signals: llmAssessment.positive_signals,
      missing_evidence: llmAssessment.missing_evidence,
      recommendations: llmAssessment.recommendations,
      similar_changes: similarChanges.map(sc => ({
        change_id: sc.change_id,
        similarity_score: sc.similarity_score,
        outcome: sc.final_outcome
      })),
      features,
      entities,
      evaluated_at: new Date().toISOString()
    };

    // Save to database (reuse db instance from parent scope)
    await db.run(
      `INSERT INTO predictions (
        prediction_id, change_id, short_description, risk_score, risk_band,
        probabilities, drivers, recommendations, similar_changes,
        features, entities, evaluated_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      [
        predictionId,
        changeData.change_id,
        changeData.short_description,
        result.risk_score,
        riskBand,
        JSON.stringify(probabilities),
        JSON.stringify(llmAssessment.drivers),
        JSON.stringify(llmAssessment.recommendations),
        JSON.stringify(result.similar_changes),
        JSON.stringify(features),
        JSON.stringify(entities),
        result.evaluated_at
      ]
    );

    // Also store in changes table
    await db.run(
      `INSERT INTO changes (
        change_id, short_description, long_description, change_type, change_category,
        complexity, implementation_steps, validation_steps, rollback_plan,
        planned_window, impacted_services, assignee, final_outcome, submitted_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      [
        changeData.change_id,
        changeData.short_description,
        changeData.long_description,
        changeData.change_type,
        changeData.change_category,
        changeData.complexity,
        JSON.stringify(changeData.implementation_steps),
        JSON.stringify(changeData.validation_steps),
        changeData.rollback_plan,
        changeData.planned_window,
        JSON.stringify(changeData.impacted_services),
        changeData.assignee,
        'pending',
        new Date().toISOString()
      ]
    );

    return {
      status: 'success',
      result
    };
  } catch (error) {
    return {
      status: 'error',
      error: error.message
    };
  }
}

/**
 * Process bulk upload
 */
async function processBulkUpload(filePath, fileType) {
  const startTime = Date.now();
  const batchId = `batch_${uuidv4()}`;

  // Step 1: Parse file
  let parseResult;
  if (fileType === 'excel') {
    parseResult = parseExcelFile(filePath);
  } else {
    parseResult = await parseCSVFile(filePath);
  }

  if (!parseResult.success) {
    return {
      success: false,
      error: parseResult.error,
      error_code: 'INVALID_FORMAT'
    };
  }

  const rows = parseResult.data;
  const totalCount = rows.length;

  if (totalCount === 0) {
    return {
      success: false,
      error: 'File contains no data rows',
      error_code: 'EMPTY_FILE'
    };
  }

  if (totalCount > 1000) {
    return {
      success: false,
      error: 'File contains more than 1000 rows. Please split into smaller batches.',
      error_code: 'FILE_TOO_LARGE'
    };
  }

  // Step 2: Validate and transform rows
  const validatedRows = [];
  const results = [];
  let successCount = 0;
  let errorCount = 0;

  // Get historical changes for similarity matching
  const db = new Database();
  let historicalChanges = await db.query('SELECT * FROM changes WHERE final_outcome IS NOT NULL');

  // Ensure historicalChanges is an array
  if (!Array.isArray(historicalChanges)) {
    historicalChanges = [];
  }

  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    const rowNumber = i + 1;

    // Validate
    const validation = validateChangeRow(row, rowNumber);

    if (!validation.valid) {
      results.push({
        row_number: rowNumber,
        status: 'error',
        short_description: row.short_description || 'N/A',
        error: validation.error,
        error_code: 'VALIDATION_ERROR'
      });
      errorCount++;
      continue;
    }

    // Transform
    const changeData = transformRowToChange(row);
    validatedRows.push({ rowNumber, changeData });
  }

  // Step 3: Process valid rows in batches (10 at a time for performance)
  const BATCH_SIZE = 10;
  for (let i = 0; i < validatedRows.length; i += BATCH_SIZE) {
    const batch = validatedRows.slice(i, i + BATCH_SIZE);
    const promises = batch.map(({ rowNumber, changeData }) =>
      processChange(changeData, historicalChanges, db)
        .then(result => ({ rowNumber, changeData, ...result }))
    );

    const batchResults = await Promise.all(promises);

    for (const result of batchResults) {
      if (result.status === 'success') {
        results.push({
          row_number: result.rowNumber,
          status: 'success',
          change_id: result.result.change_id,
          short_description: result.changeData.short_description,
          risk_score: result.result.risk_score,
          risk_band: result.result.risk_band,
          prediction_id: result.result.prediction_id
        });
        successCount++;
      } else {
        results.push({
          row_number: result.rowNumber,
          status: 'error',
          short_description: result.changeData.short_description,
          error: result.error,
          error_code: 'PROCESSING_ERROR'
        });
        errorCount++;
      }
    }
  }

  // Step 4: Calculate summary
  const riskDistribution = { Low: 0, Medium: 0, High: 0, Critical: 0 };
  let totalRiskScore = 0;
  let riskScoreCount = 0;

  for (const result of results) {
    if (result.status === 'success' && result.risk_band) {
      riskDistribution[result.risk_band]++;
      totalRiskScore += result.risk_score;
      riskScoreCount++;
    }
  }

  const avgRiskScore = riskScoreCount > 0 ? Math.round((totalRiskScore / riskScoreCount) * 100) / 100 : 0;

  const processingTime = Date.now() - startTime;

  return {
    success: true,
    batch_id: batchId,
    uploaded_at: new Date().toISOString(),
    total_count: totalCount,
    processed_count: results.length,
    success_count: successCount,
    error_count: errorCount,
    processing_time_ms: processingTime,
    results,
    summary: {
      risk_distribution: riskDistribution,
      avg_risk_score: avgRiskScore
    }
  };
}

module.exports = {
  processBulkUpload,
  validateChangeRow,
  transformRowToChange
};
